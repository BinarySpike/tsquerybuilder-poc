{
  "name": "topheavy",
  "version": "0.1.0",
  "description": "TopHeavy query builder and type validation library",
  "type": "module",
  "exports": {
    "./query": {
      "import": "./dist/query/index.js",
      "types": "./dist/query/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./orm": {
      "import": "./dist/orm/index.js",
      "types": "./dist/orm/index.d.ts"
    },
    "./orm/inMemory": {
      "import": "./dist/orm/inMemory.js",
      "types": "./dist/orm/inMemory.d.ts"
    },
    "./orm/localStorage": {
      "import": "./dist/orm/localStorage.js",
      "types": "./dist/orm/localStorage.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "observable-slim": "^0.2.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
