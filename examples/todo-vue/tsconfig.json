{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@topheavy/orm/localStorage": ["../../packages/orm/src/localStorage.ts"],
      "@topheavy/orm/inMemory": ["../../packages/orm/src/inMemory.ts"],
      "@topheavy/orm": ["../../packages/orm/src/index.ts"],
      "@topheavy/schema": ["../../packages/schema/src/index.ts"],
      "@topheavy/query": ["../../packages/query/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
